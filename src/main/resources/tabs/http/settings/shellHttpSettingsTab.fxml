<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.button.SaveButton?>
<?import cn.oyzh.fx.gui.text.field.NumberTextField?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.button.FXCheckBox?>
<?import cn.oyzh.fx.plus.controls.combo.FXComboBox?>
<?import cn.oyzh.fx.plus.controls.label.FXLabel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.http.settings.ShellHttpSettingsTabController"
        flexWidth="100%" flexHeight="100%">
    <InfoLabel text="%shell.http.timeout">
        <VBox.margin>
            <Insets left="20" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXHBox>
        <NumberTextField fx:id="timeout" min="1" max="600" realHeight="30" realWidth="140">
            <HBox.margin>
                <Insets left="20"/>
            </HBox.margin>
        </NumberTextField>
        <FXLabel text="%base.seconds" realHeight="24">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </FXLabel>
    </FXHBox>
    <InfoLabel text="%shell.http.maxResponseSize">
        <VBox.margin>
            <Insets left="20" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXHBox>
        <NumberTextField fx:id="maxResponseSize" min="1" max="10240" realHeight="30" realWidth="140">
            <HBox.margin>
                <Insets left="20"/>
            </HBox.margin>
        </NumberTextField>
        <FXLabel text="%shell.http.mb" realHeight="24">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </FXLabel>
    </FXHBox>
    <InfoLabel text="%shell.http.maxResponseSizeTip">
        <VBox.margin>
            <Insets left="20" top="6"/>
        </VBox.margin>
    </InfoLabel>
    <InfoLabel text="%shell.http.activeEnvironment">
        <VBox.margin>
            <Insets left="20" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXComboBox fx:id="environmentCombo" realHeight="30" flexWidth="100% - 140">
        <VBox.margin>
            <Insets left="20" top="5"/>
        </VBox.margin>
    </FXComboBox>
    <InfoLabel text="%shell.http.httpVersion">
        <VBox.margin>
            <Insets left="20" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXComboBox fx:id="httpVersion" realHeight="30" flexWidth="100% - 140">
        <VBox.margin>
            <Insets left="20" top="5"/>
        </VBox.margin>
    </FXComboBox>
    <InfoLabel text="%shell.http.options">
        <VBox.margin>
            <Insets left="20" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXHBox flexWidth="100%" realHeight="32">
        <FXCheckBox fx:id="followRedirects" text="%shell.http.followRedirects">
            <HBox.margin>
                <Insets left="20" top="5"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox fx:id="verifySsl" text="%shell.http.verifySsl">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox fx:id="prettyJson" text="%shell.http.prettyJson">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox fx:id="sendNoCacheHeader" text="%shell.http.sendNoCacheHeader">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </FXCheckBox>
    </FXHBox>
    <FXVBox VBox.vgrow="ALWAYS"/>
    <FXHBox flexWidth="100%" realHeight="50">
        <SaveButton onAction="#save">
            <HBox.margin>
                <Insets left="20" top="10"/>
            </HBox.margin>
        </SaveButton>
    </FXHBox>
</FXVBox>
