<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyshell.fx.http.ShellHttpFormDataTableView?>
<?import cn.oyzh.easyshell.fx.http.ShellHttpCookieTableView?>
<?import cn.oyzh.easyshell.fx.http.ShellHttpKeyValueTableView?>
<?import cn.oyzh.easyshell.fx.http.ShellHttpResponseHeadersTableView?>
<?import cn.oyzh.easyshell.fx.ShellDataEditor?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.llm.SendSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.tabs.RichTabPane?>
<?import cn.oyzh.fx.gui.text.field.ChooseFileTextField?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.gui.text.field.NumberTextField?>
<?import cn.oyzh.fx.gui.text.field.PasswordTextField?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.button.FXButton?>
<?import cn.oyzh.fx.plus.controls.button.FXCheckBox?>
<?import cn.oyzh.fx.plus.controls.combo.FXComboBox?>
<?import cn.oyzh.fx.plus.controls.hex.HexView?>
<?import cn.oyzh.fx.plus.controls.label.FXLabel?>
<?import cn.oyzh.fx.plus.controls.pane.FXSplitPane?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import cn.oyzh.fx.plus.controls.toggle.FXToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.http.request.ShellHttpRequestTabController"
        fx:id="root" flexWidth="100%" flexHeight="100%">
    <FXHBox flexWidth="100%" realHeight="48">
        <FXComboBox fx:id="method" realHeight="30" realWidth="105">
            <HBox.margin>
                <Insets left="8" top="9"/>
            </HBox.margin>
        </FXComboBox>
        <ClearableTextField fx:id="requestUrl" promptText="%shell.http.requestUrlTip"
                            realHeight="30" flexWidth="100% - 250">
            <HBox.margin>
                <Insets left="6" top="9"/>
            </HBox.margin>
        </ClearableTextField>
        <SendSVGGlyph fx:id="send" tipText="%shell.http.sendTip"
                      onMousePrimaryClicked="#sendRequest">
            <HBox.margin>
                <Insets left="10" top="15"/>
            </HBox.margin>
        </SendSVGGlyph>
        <SaveSVGGlyph tipText="%base.save" onMousePrimaryClicked="#saveRequest">
            <HBox.margin>
                <Insets left="10" top="15"/>
            </HBox.margin>
        </SaveSVGGlyph>
    </FXHBox>
    <FXSplitPane orientation="VERTICAL" dividerPositions="0.48"
                 flexWidth="100%" flexHeight="100% - 48">
        <FXVBox flexWidth="100%">
            <RichTabPane fx:id="requestTabPane" flexWidth="100%" flexHeight="100%"
                         tabMinHeight="28" tabClosingPolicy="UNAVAILABLE" side="TOP">
                <FixedTab text="%shell.http.params">
                    <FXVBox flexWidth="100%" flexHeight="100%">
                        <FXHBox flexWidth="100%" realHeight="32">
                            <AddSVGGlyph tipText="%shell.http.addParam"
                                         onMousePrimaryClicked="#addParam">
                                <HBox.margin>
                                    <Insets left="6" top="5"/>
                                </HBox.margin>
                            </AddSVGGlyph>
                            <DeleteSVGGlyph tipText="%shell.http.deleteParam"
                                            onMousePrimaryClicked="#deleteParam">
                                <HBox.margin>
                                    <Insets left="6" top="5"/>
                                </HBox.margin>
                            </DeleteSVGGlyph>
                        </FXHBox>
                        <ShellHttpKeyValueTableView fx:id="paramsTable" descriptionVisible="true"
                                                    flexWidth="100%" flexHeight="100% - 32"/>
                    </FXVBox>
                </FixedTab>
                <FixedTab text="%shell.http.headers">
                    <FXVBox flexWidth="100%" flexHeight="100%">
                        <FXHBox flexWidth="100%" realHeight="32">
                            <AddSVGGlyph tipText="%shell.http.addHeader"
                                         onMousePrimaryClicked="#addHeader">
                                <HBox.margin>
                                    <Insets left="6" top="5"/>
                                </HBox.margin>
                            </AddSVGGlyph>
                            <DeleteSVGGlyph tipText="%shell.http.deleteHeader"
                                            onMousePrimaryClicked="#deleteHeader">
                                <HBox.margin>
                                    <Insets left="6" top="5"/>
                                </HBox.margin>
                            </DeleteSVGGlyph>
                        </FXHBox>
                        <ShellHttpKeyValueTableView fx:id="headersTable" descriptionVisible="true"
                                                    flexWidth="100%" flexHeight="100% - 32"/>
                    </FXVBox>
                </FixedTab>
                <FixedTab text="%shell.http.body">
                    <FXVBox flexWidth="100%" flexHeight="100%">
                        <FXHBox flexWidth="100%" realHeight="42">
                            <InfoLabel text="%shell.http.bodyType" realWidth="120">
                                <HBox.margin>
                                    <Insets left="8" top="6"/>
                                </HBox.margin>
                            </InfoLabel>
                            <FXComboBox fx:id="bodyType" realHeight="28" realWidth="180">
                                <HBox.margin>
                                    <Insets left="8" top="7"/>
                                </HBox.margin>
                            </FXComboBox>
                            <FXHBox fx:id="rawContentTypeBox" realHeight="42">
                                <InfoLabel text="%shell.http.contentType" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="12" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <FXComboBox fx:id="rawContentType" realHeight="28" realWidth="230">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </FXComboBox>
                                <HBox.margin>
                                    <Insets left="4"/>
                                </HBox.margin>
                            </FXHBox>
                        </FXHBox>
                        <FXHBox fx:id="binaryBodyBox" flexWidth="100%" realHeight="42"
                                visible="false" managed="false">
                            <InfoLabel text="%shell.http.bodyFile" realWidth="120">
                                <HBox.margin>
                                    <Insets left="8" top="6"/>
                                </HBox.margin>
                            </InfoLabel>
                            <ChooseFileTextField fx:id="bodyFile" realHeight="28"
                                                 flexWidth="100% - 160">
                                <HBox.margin>
                                    <Insets left="8" top="7"/>
                                </HBox.margin>
                            </ChooseFileTextField>
                        </FXHBox>
                        <FXVBox fx:id="formDataBodyBox" flexWidth="100%" flexHeight="100% - 42"
                                visible="false" managed="false">
                            <FXHBox flexWidth="100%" realHeight="32">
                                <AddSVGGlyph tipText="%shell.http.addFormField"
                                             onMousePrimaryClicked="#addFormData">
                                    <HBox.margin>
                                        <Insets left="6" top="5"/>
                                    </HBox.margin>
                                </AddSVGGlyph>
                                <DeleteSVGGlyph tipText="%shell.http.deleteFormField"
                                                onMousePrimaryClicked="#deleteFormData">
                                    <HBox.margin>
                                        <Insets left="6" top="5"/>
                                    </HBox.margin>
                                </DeleteSVGGlyph>
                            </FXHBox>
                            <ShellHttpFormDataTableView fx:id="formDataTable"
                                                        flexWidth="100%" flexHeight="100% - 32"/>
                        </FXVBox>
                        <FXVBox fx:id="formBodyBox" flexWidth="100%" flexHeight="100% - 42"
                                visible="false" managed="false">
                            <FXHBox flexWidth="100%" realHeight="32">
                                <AddSVGGlyph tipText="%shell.http.addFormField"
                                             onMousePrimaryClicked="#addFormBody">
                                    <HBox.margin>
                                        <Insets left="6" top="5"/>
                                    </HBox.margin>
                                </AddSVGGlyph>
                                <DeleteSVGGlyph tipText="%shell.http.deleteFormField"
                                                onMousePrimaryClicked="#deleteFormBody">
                                    <HBox.margin>
                                        <Insets left="6" top="5"/>
                                    </HBox.margin>
                                </DeleteSVGGlyph>
                            </FXHBox>
                            <ShellHttpKeyValueTableView fx:id="formBodyTable" descriptionVisible="true"
                                                        flexWidth="100%" flexHeight="100% - 32"/>
                        </FXVBox>
                        <FXHBox fx:id="rawBodyBox" flexWidth="100%" flexHeight="100% - 42"
                                visible="false" managed="false">
                            <ShellDataEditor fx:id="requestBody" flexWidth="100%" flexHeight="100%"/>
                        </FXHBox>
                    </FXVBox>
                </FixedTab>
                <FixedTab text="%shell.http.auth">
                    <FXVBox flexWidth="100%" flexHeight="100%">
                        <FXHBox flexWidth="100%" realHeight="42">
                            <InfoLabel text="%shell.http.authType" realWidth="120">
                                <HBox.margin>
                                    <Insets left="10" top="6"/>
                                </HBox.margin>
                            </InfoLabel>
                            <FXComboBox fx:id="authType" realHeight="28" flexWidth="100% - 160">
                                <HBox.margin>
                                    <Insets left="8" top="7"/>
                                </HBox.margin>
                            </FXComboBox>
                        </FXHBox>
                        <FXVBox fx:id="basicAuthBox" flexWidth="100%"
                                visible="false" managed="false">
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%base.userName" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <ClearableTextField fx:id="authUser" realHeight="28"
                                                    flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </ClearableTextField>
                            </FXHBox>
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%base.password" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <PasswordTextField fx:id="authPassword" realHeight="28"
                                                   flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </PasswordTextField>
                            </FXHBox>
                        </FXVBox>
                        <FXHBox fx:id="bearerAuthBox" flexWidth="100%" realHeight="42"
                                visible="false" managed="false">
                            <InfoLabel text="%base.token" realWidth="120">
                                <HBox.margin>
                                    <Insets left="10" top="6"/>
                                </HBox.margin>
                            </InfoLabel>
                            <PasswordTextField fx:id="authToken" realHeight="28"
                                               flexWidth="100% - 160">
                                <HBox.margin>
                                    <Insets left="8" top="7"/>
                                </HBox.margin>
                            </PasswordTextField>
                        </FXHBox>
                        <FXVBox fx:id="oauth2AuthBox" flexWidth="100%"
                                visible="false" managed="false">
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%shell.http.oauth2TokenUrl" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <ClearableTextField fx:id="oauth2TokenUrl" realHeight="28"
                                                    flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </ClearableTextField>
                            </FXHBox>
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%shell.http.oauth2ClientId" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <ClearableTextField fx:id="oauth2ClientId" realHeight="28"
                                                    flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </ClearableTextField>
                            </FXHBox>
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%shell.http.oauth2ClientSecret" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <PasswordTextField fx:id="oauth2ClientSecret" realHeight="28"
                                                   flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </PasswordTextField>
                            </FXHBox>
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%shell.http.oauth2Scope" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <ClearableTextField fx:id="oauth2Scope" realHeight="28"
                                                    flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </ClearableTextField>
                            </FXHBox>
                        </FXVBox>
                        <FXVBox fx:id="apiKeyBox" flexWidth="100%"
                                visible="false" managed="false">
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%shell.http.keyName" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <ClearableTextField fx:id="authKeyName" realHeight="28"
                                                    flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </ClearableTextField>
                            </FXHBox>
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%shell.http.keyValue" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <PasswordTextField fx:id="authKeyValue" realHeight="28"
                                                   flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </PasswordTextField>
                            </FXHBox>
                            <FXHBox flexWidth="100%" realHeight="42">
                                <InfoLabel text="%shell.http.addTo" realWidth="120">
                                    <HBox.margin>
                                        <Insets left="10" top="6"/>
                                    </HBox.margin>
                                </InfoLabel>
                                <FXComboBox fx:id="authKeyPlacement" realHeight="28"
                                            flexWidth="100% - 160">
                                    <HBox.margin>
                                        <Insets left="8" top="7"/>
                                    </HBox.margin>
                                </FXComboBox>
                            </FXHBox>
                        </FXVBox>
                    </FXVBox>
                </FixedTab>
                <FixedTab text="%shell.http.preRequestScript">
                    <ShellDataEditor fx:id="preRequestScript" flexWidth="100%" flexHeight="100%"/>
                </FixedTab>
                <FixedTab text="%shell.http.testScript">
                    <ShellDataEditor fx:id="testScript" flexWidth="100%" flexHeight="100%"/>
                </FixedTab>
                <FixedTab text="%shell.http.requestSettings">
                    <FXVBox flexWidth="100%" flexHeight="100%" spacing="8">
                        <padding>
                            <Insets left="20" top="12"/>
                        </padding>
                        <FXHBox>
                            <InfoLabel text="%shell.http.timeout" realWidth="120"/>
                            <NumberTextField fx:id="requestTimeout" min="1" max="600"
                                             realHeight="30" realWidth="140"/>
                            <FXLabel text="%base.seconds" realHeight="24">
                                <HBox.margin>
                                    <Insets left="5" top="4"/>
                                </HBox.margin>
                            </FXLabel>
                        </FXHBox>
                        <FXHBox>
                            <InfoLabel text="%shell.http.httpVersion" realWidth="120"/>
                            <FXComboBox fx:id="requestHttpVersion" realHeight="30" realWidth="220"/>
                        </FXHBox>
                        <FXHBox>
                            <InfoLabel text="%shell.http.options" realWidth="120"/>
                            <FXCheckBox fx:id="requestFollowRedirects"
                                        text="%shell.http.followRedirects">
                                <HBox.margin>
                                    <Insets top="4"/>
                                </HBox.margin>
                            </FXCheckBox>
                            <FXCheckBox fx:id="requestNoCacheHeader"
                                        text="%shell.http.sendNoCacheHeader">
                                <HBox.margin>
                                    <Insets left="14" top="4"/>
                                </HBox.margin>
                            </FXCheckBox>
                        </FXHBox>
                    </FXVBox>
                </FixedTab>
            </RichTabPane>
        </FXVBox>
        <FXVBox flexWidth="100%">
            <FXHBox flexWidth="100%" realHeight="38">
                <InfoLabel text="%shell.http.response">
                    <HBox.margin>
                        <Insets left="8" top="7"/>
                    </HBox.margin>
                </InfoLabel>
                <FXLabel fx:id="responseStatus" text="-" realHeight="24">
                    <HBox.margin>
                        <Insets left="10" top="9"/>
                    </HBox.margin>
                </FXLabel>
                <FXLabel fx:id="responseTime" text="-" realHeight="24">
                    <HBox.margin>
                        <Insets left="10" top="9"/>
                    </HBox.margin>
                </FXLabel>
                <FXLabel fx:id="responseSize" text="-" realHeight="24">
                    <HBox.margin>
                        <Insets left="10" top="9"/>
                    </HBox.margin>
                </FXLabel>
                <FXButton fx:id="preview" text="%shell.http.openHtml"
                          onAction="#previewHtml" realHeight="26" disable="true">
                    <HBox.margin>
                        <Insets left="10" top="6"/>
                    </HBox.margin>
                </FXButton>
                <FXButton fx:id="saveResponseBody" text="%shell.http.saveResponseBody"
                          onAction="#saveResponseBody" realHeight="26" disable="true">
                    <HBox.margin>
                        <Insets left="10" top="6"/>
                    </HBox.margin>
                </FXButton>
                <FXButton fx:id="openResponseFile" text="%shell.http.openResponseFile"
                          onAction="#openResponseFile" realHeight="26" disable="true">
                    <HBox.margin>
                        <Insets left="10" top="6"/>
                    </HBox.margin>
                </FXButton>
            </FXHBox>
            <RichTabPane fx:id="responseTabPane" flexWidth="100%" flexHeight="100% - 38"
                         tabMinHeight="28" tabClosingPolicy="UNAVAILABLE">
                <FixedTab text="%shell.http.responseBody">
                    <FXVBox flexWidth="100%" flexHeight="100%">
                        <FXHBox flexWidth="100%" realHeight="36" alignment="CENTER_LEFT">
                            <InfoLabel text="%shell.http.responseFormat" realWidth="60">
                                <HBox.margin>
                                    <Insets left="8"/>
                                </HBox.margin>
                            </InfoLabel>
                            <FXComboBox fx:id="responseFormat" realHeight="26" realWidth="100">
                                <HBox.margin>
                                    <Insets left="6"/>
                                </HBox.margin>
                            </FXComboBox>
                        </FXHBox>
                        <ShellDataEditor fx:id="responseBody" editable="false"
                                         flexWidth="100%" flexHeight="100% - 36"/>
                    </FXVBox>
                </FixedTab>
                <FixedTab fx:id="responseBase64Tab" text="%shell.http.responseBase64">
                    <ShellDataEditor fx:id="responseBase64" editable="false"
                                     flexWidth="100%" flexHeight="100%"/>
                </FixedTab>
                <FixedTab fx:id="responseHexTab" text="%shell.http.responseHex">
                    <HexView fx:id="responseHex" flexWidth="100%" flexHeight="100%"/>
                </FixedTab>
                <FixedTab text="%shell.http.responseCookies">
                    <ShellHttpCookieTableView fx:id="responseCookies"
                                              flexWidth="100%" flexHeight="100%"/>
                </FixedTab>
                <FixedTab text="%shell.http.responseHeaders">
                    <FXVBox flexWidth="100%" flexHeight="100%">
                        <FXHBox flexWidth="100%" realHeight="32">
                            <FXToggleSwitch fx:id="responseHeadersTableMode"
                                            text="%shell.http.responseHeadersTable" selected="true">
                                <HBox.margin>
                                    <Insets left="8" top="4"/>
                                </HBox.margin>
                            </FXToggleSwitch>
                        </FXHBox>
                        <ShellHttpResponseHeadersTableView fx:id="responseHeadersTable"
                                                           flexWidth="100%" flexHeight="100% - 32"/>
                        <ShellDataEditor fx:id="responseHeaders" editable="false"
                                         flexWidth="100%" flexHeight="100% - 32"
                                         visible="false" managed="false"/>
                    </FXVBox>
                </FixedTab>
                <FixedTab text="%shell.http.testResults">
                    <ShellDataEditor fx:id="testResults" editable="false"
                                     flexWidth="100%" flexHeight="100%"/>
                </FixedTab>
            </RichTabPane>
        </FXVBox>
    </FXSplitPane>
</FXVBox>
