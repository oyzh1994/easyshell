<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyshell.fx.http.ShellHttpKeyValueTableView?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.http.environment.ShellHttpEnvironmentTabController"
        flexWidth="100%" flexHeight="100%">
    <FXHBox flexWidth="100%" realHeight="50">
        <InfoLabel text="%shell.http.environmentName">
            <HBox.margin>
                <Insets left="12" top="16"/>
            </HBox.margin>
        </InfoLabel>
        <ClearableTextField fx:id="environmentName" promptText="%shell.http.environmentName" realHeight="28"
                            flexWidth="100% - 230">
            <HBox.margin>
                <Insets left="8" top="10"/>
            </HBox.margin>
        </ClearableTextField>
        <SaveSVGGlyph tipText="%base.save" onMousePrimaryClicked="#save">
            <HBox.margin>
                <Insets left="10" top="12"/>
            </HBox.margin>
        </SaveSVGGlyph>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="32">
        <AddSVGGlyph tipText="%shell.http.addVariable" onMousePrimaryClicked="#addValue">
            <HBox.margin>
                <Insets left="12" top="4"/>
            </HBox.margin>
        </AddSVGGlyph>
        <DeleteSVGGlyph tipText="%shell.http.deleteVariable" onMousePrimaryClicked="#deleteValue">
            <HBox.margin>
                <Insets left="8" top="4"/>
            </HBox.margin>
        </DeleteSVGGlyph>
    </FXHBox>
    <ShellHttpKeyValueTableView fx:id="valuesTable" flexWidth="100%" flexHeight="100% - 82"/>
</FXVBox>
