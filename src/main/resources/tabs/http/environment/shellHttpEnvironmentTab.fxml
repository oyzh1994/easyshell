<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyshell.fx.http.ShellHttpKeyValueTableView?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.http.environment.ShellHttpEnvironmentTabController"
        flexWidth="100%" flexHeight="100%">
    <FXHBox flexWidth="100%" realHeight="38">
        <AddSVGGlyph tipText="%shell.http.addVariable" onMousePrimaryClicked="#addValue">
            <HBox.margin>
                <Insets left="12" top="7"/>
            </HBox.margin>
        </AddSVGGlyph>
        <DeleteSVGGlyph tipText="%shell.http.deleteVariable" onMousePrimaryClicked="#deleteValue">
            <HBox.margin>
                <Insets left="8" top="7"/>
            </HBox.margin>
        </DeleteSVGGlyph>
        <SaveSVGGlyph tipText="%base.save" onMousePrimaryClicked="#save">
            <HBox.margin>
                <Insets left="8" top="7"/>
            </HBox.margin>
        </SaveSVGGlyph>
    </FXHBox>
    <ShellHttpKeyValueTableView fx:id="valuesTable" flexWidth="100%" flexHeight="100% - 38"/>
</FXVBox>
