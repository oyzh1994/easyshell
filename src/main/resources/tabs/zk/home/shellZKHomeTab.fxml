<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.label.FXLabel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<FXVBox flexHeight="100%" flexWidth="100%" xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.zk.home.ShellZKHomeTabController">
    <InfoLabel text="%base.version">
        <VBox.margin>
            <Insets left="30" top="20"/>
        </VBox.margin>
    </InfoLabel>
    <FXLabel realHeight="26" fx:id="version">
        <VBox.margin>
            <Insets left="30" top="3"/>
        </VBox.margin>
    </FXLabel>
    <InfoLabel text="%base.mode">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXLabel realHeight="26" fx:id="mode">
        <VBox.margin>
            <Insets left="30" top="3"/>
        </VBox.margin>
    </FXLabel>
    <InfoLabel text="%base.id">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXLabel realHeight="26" fx:id="zxid">
        <VBox.margin>
            <Insets left="30" top="3"/>
        </VBox.margin>
    </FXLabel>
    <InfoLabel text="%base.nodeCount">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXLabel realHeight="26" fx:id="nodeCount">
        <VBox.margin>
            <Insets left="30" top="3"/>
        </VBox.margin>
    </FXLabel>
    <InfoLabel text="%base.connections">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXLabel realHeight="26" fx:id="connections">
        <VBox.margin>
            <Insets left="30" top="3"/>
        </VBox.margin>
    </FXLabel>
    <InfoLabel text="%base.latency">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXLabel realHeight="26" fx:id="latency">
        <VBox.margin>
            <Insets left="30" top="3"/>
        </VBox.margin>
    </FXLabel>
    <InfoLabel text="%base.cmd">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXLabel realHeight="26" fx:id="command">
        <VBox.margin>
            <Insets left="30" top="3" bottom="20"/>
        </VBox.margin>
    </FXLabel>
</FXVBox>
