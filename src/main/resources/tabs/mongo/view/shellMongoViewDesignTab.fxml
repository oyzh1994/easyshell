<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.ShellDataEditor?>
<?import cn.oyzh.fx.gui.label.AccentLabel?>
<?import cn.oyzh.fx.gui.svg.glyph.RefreshSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.tabs.RichTabPane?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.combo.FXComboBox?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.mongo.view.ShellMongoViewDesignTabController"
        flexWidth="100%" flexHeight="100%">
    <FXHBox realHeight="25" flexWidth="100%">
        <SaveSVGGlyph onMousePrimaryClicked="#save">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </SaveSVGGlyph>
        <RefreshSVGGlyph groupId="action3" onMousePrimaryClicked="#refresh"
                         managedBindVisible="true" visible="false">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </RefreshSVGGlyph>
    </FXHBox>
    <RichTabPane fx:id="tabPane" flexWidth="100%" flexHeight="100% - 25">
        <FixedTab text="%base.definition">
            <FXVBox flexWidth="100%" flexHeight="100%">
                <AccentLabel realHeight="30" text="%shell.mongo.viewSource">
                    <VBox.margin>
                        <Insets left="20" top="10"/>
                    </VBox.margin>
                </AccentLabel>
                <FXComboBox fx:id="viewOn" realHeight="30" flexWidth="100% - 40">
                    <VBox.margin>
                        <Insets left="20" top="5"/>
                    </VBox.margin>
                </FXComboBox>
                <AccentLabel realHeight="30" text="%shell.mongo.viewPipeline">
                    <VBox.margin>
                        <Insets left="20" top="10"/>
                    </VBox.margin>
                </AccentLabel>
                <ShellDataEditor formatType="JSON" fx:id="pipeline" tipText="%shell.mongo.viewPipeline"
                                 flexWidth="100% - 40"
                                 flexHeight="100% - 120">
                    <VBox.margin>
                        <Insets left="20" top="5"/>
                    </VBox.margin>
                </ShellDataEditor>
            </FXVBox>
        </FixedTab>
        <FixedTab text="%base.preview" fx:id="previewTab">
            <ShellDataEditor formatType="JAVASCRIPT" editable="false" fx:id="preview" flexWidth="100%"
                             flexHeight="100%"/>
        </FixedTab>
    </RichTabPane>
</FXVBox>
