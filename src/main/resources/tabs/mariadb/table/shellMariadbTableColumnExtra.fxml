<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.db.ShellDBEnumTextFiled?>
<?import cn.oyzh.easyshell.fx.mariadb.MariadbColumnKindComboBox?>
<?import cn.oyzh.easyshell.fx.mariadb.ShellMariadbCharsetComboBox?>
<?import cn.oyzh.easyshell.fx.mariadb.ShellMariadbCollationComboBox?>
<?import cn.oyzh.easyshell.fx.mariadb.table.ShellMariadbDefaultValueTextFiled?>
<?import cn.oyzh.fx.gui.label.AccentLabel?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.gui.text.field.NumberTextField?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.button.FXCheckBox?>
<?import cn.oyzh.fx.plus.controls.combo.FXComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.tabs.mariadb.table.ShellMariadbTableColumnExtraController" realHeight="270">
    <FXHBox flexWidth="100%" realHeight="30" fx:id="columnKindBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%shell.sqlite.column.kind">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <MariadbColumnKindComboBox fx:id="columnKind" realHeight="25" flexWidth="100% - 140">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </MariadbColumnKindComboBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="valueBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%base.value">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <ShellDBEnumTextFiled fx:id="value" realHeight="25" flexWidth="100% - 140" styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </ShellDBEnumTextFiled>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="defaultValueBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%base.defaultValue">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <ShellMariadbDefaultValueTextFiled fx:id="defaultValue" flexWidth="100% - 140" realHeight="25"
                                         styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </ShellMariadbDefaultValueTextFiled>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="currentTimestampBox" managed="false" visible="false">
        <FXCheckBox fx:id="currentTimestamp" prefHeight="25" text="%base.updateByCurrentTimestamp">
            <HBox.margin>
                <Insets left="95" top="5"/>
            </HBox.margin>
        </FXCheckBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="charsetBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%base.charset">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <ShellMariadbCharsetComboBox fx:id="charset" flexWidth="100% - 140" realHeight="25" styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </ShellMariadbCharsetComboBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="collationBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%base.collation">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <ShellMariadbCollationComboBox fx:id="collation" flexWidth="100% - 140" realHeight="25" styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </ShellMariadbCollationComboBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="autoIncrementBox" managed="false" visible="false">
        <FXCheckBox fx:id="autoIncrement" prefHeight="25" text="%base.autoIncrement">
            <HBox.margin>
                <Insets left="95" top="5"/>
            </HBox.margin>
        </FXCheckBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="unsignedBox" managed="false" visible="false">
        <FXCheckBox fx:id="unsigned" prefHeight="25" text="%base.unsigned">
            <HBox.margin>
                <Insets left="95" top="5"/>
            </HBox.margin>
        </FXCheckBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="zeroFillBox" managed="false" visible="false">
        <FXCheckBox fx:id="zeroFill" prefHeight="25" text="%base.zeroFill">
            <HBox.margin>
                <Insets left="95" top="5"/>
            </HBox.margin>
        </FXCheckBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="primaryKeySizeBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%base.keySize">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <NumberTextField minVal="0" fx:id="primaryKeySize" flexWidth="100% - 140" realHeight="25"
                         styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </NumberTextField>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="generatedExpressionBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%shell.sqlite.expression">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <ClearableTextField fx:id="generatedExpression" realHeight="25" flexWidth="100% - 140"
                            styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </ClearableTextField>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="generatedStorageBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%shell.sqlite.generatedStorage">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <FXComboBox fx:id="generatedStorage" realHeight="25" flexWidth="100% - 140">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </FXComboBox>
    </FXHBox>
</FXVBox>
