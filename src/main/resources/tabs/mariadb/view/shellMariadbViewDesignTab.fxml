<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.mariadb.ShellMariadbSecurityTypeComboBox?>
<?import cn.oyzh.easyshell.fx.mariadb.view.ShellMariadbViewAlgorithmComboBox?>
<?import cn.oyzh.easyshell.fx.mariadb.view.ShellMariadbViewCheckOptionComboBox?>
<?import cn.oyzh.easyshell.fx.ShellDataEditor?>
<?import cn.oyzh.easyshell.query.mariadb.ShellMariadbQueryEditor?>
<?import cn.oyzh.fx.gui.label.AccentLabel?>
<?import cn.oyzh.fx.gui.svg.glyph.RefreshSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.tabs.RichTabPane?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import cn.oyzh.fx.plus.controls.text.field.FXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.mariadb.view.ShellMariadbViewDesignTabController" flexWidth="100%"
        flexHeight="100%">
    <FXHBox realHeight="25" flexWidth="100%">
        <SaveSVGGlyph fx:id="save" onMousePrimaryClicked="#save">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </SaveSVGGlyph>
        <RefreshSVGGlyph groupId="action3" onMousePrimaryClicked="#refresh"
                         managedBindVisible="true" visible="false">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </RefreshSVGGlyph>
    </FXHBox>
    <RichTabPane flexWidth="100%" flexHeight="100% - 25" fx:id="tabPane">
        <FixedTab text="%base.definition">
            <ShellMariadbQueryEditor fx:id="definition" flexHeight="100%" flexWidth="100%"/>
        </FixedTab>
        <FixedTab text="%base.advanced">
            <FXVBox flexHeight="100%" flexWidth="100%">
                <FXHBox realHeight="50" flexWidth="100%">
                    <AccentLabel text="%base.algorithm" realWidth="85" realHeight="25">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ShellMariadbViewAlgorithmComboBox fx:id="algorithm" flexWidth="100% - 140" realHeight="30">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ShellMariadbViewAlgorithmComboBox>
                </FXHBox>
                <FXHBox realHeight="50" flexWidth="100%">
                    <AccentLabel realWidth="85" text="%base.definer" realHeight="25">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <FXTextField fx:id="definer" flexWidth="100% - 140" realHeight="30">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </FXTextField>
                </FXHBox>
                <FXHBox realHeight="50" flexWidth="100%">
                    <AccentLabel realWidth="85" text="%base.securityType" realHeight="25">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ShellMariadbSecurityTypeComboBox fx:id="securityType" flexWidth="100% - 140" realHeight="30">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ShellMariadbSecurityTypeComboBox>
                </FXHBox>
                <FXHBox realHeight="50" flexWidth="100%">
                    <AccentLabel realWidth="85" text="%base.checkOption" realHeight="25">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </AccentLabel>
                    <ShellMariadbViewCheckOptionComboBox fx:id="checkOption" flexWidth="100% - 140" realHeight="30">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ShellMariadbViewCheckOptionComboBox>
                </FXHBox>
            </FXVBox>
        </FixedTab>
        <FixedTab text="%base.preview" fx:id="previewTab">
            <ShellDataEditor formatType="SQL" editable="false" fx:id="preview" flexWidth="100%" flexHeight="100%"/>
        </FixedTab>
    </RichTabPane>
</FXVBox>

