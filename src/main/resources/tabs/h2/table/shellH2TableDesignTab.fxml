<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyshell.fx.ShellDataEditor?>
<?import cn.oyzh.fx.db.ui.DBStatusColumn?>
<?import cn.oyzh.fx.db.ui.DBStatusTableView?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.MoveDownSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.MoveUpSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RefreshSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.tabs.RichTabPane?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import cn.oyzh.fx.plus.controls.table.FXTableColumn?>
<?import cn.oyzh.fx.plus.controls.text.area.FXTextArea?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.tabs.h2.table.ShellH2TableDesignTabController"
        flexWidth="100%" flexHeight="100%">
    <FXHBox realHeight="25" flexWidth="100%">
        <SaveSVGGlyph tipText="%shell.h2.save" onMousePrimaryClicked="#save">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </SaveSVGGlyph>
        <AddSVGGlyph groupId="action1" onMousePrimaryClicked="#doAdd" managedBindVisible="true">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </AddSVGGlyph>
        <DeleteSVGGlyph groupId="action1" onMousePrimaryClicked="#doDelete"
                        managedBindVisible="true">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </DeleteSVGGlyph>
        <MoveUpSVGGlyph groupId="action2" onMousePrimaryClicked="#doMoveUp"
                        managedBindVisible="true" visible="false">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </MoveUpSVGGlyph>
        <MoveDownSVGGlyph groupId="action2" onMousePrimaryClicked="#doMoveDown"
                          managedBindVisible="true" visible="false">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </MoveDownSVGGlyph>
        <RefreshSVGGlyph groupId="action3" onMousePrimaryClicked="#refresh"
                         managedBindVisible="true" visible="false">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </RefreshSVGGlyph>
    </FXHBox>
    <RichTabPane fx:id="tabPane" flexWidth="100%" flexHeight="100% - 25">
        <FixedTab text="%base.fields" fx:id="columnTab">
            <FXVBox flexWidth="100%" flexHeight="100%">
                <DBStatusTableView fixedCellSize="30" fx:id="columnTable" flexWidth="100%" flexHeight="100% - 200">
                    <columns>
                        <DBStatusColumn/>
                        <FXTableColumn flexWidth="20%" valueName="nameControl" text="%base.name"/>
                        <FXTableColumn flexWidth="22%" valueName="typeControl" text="%base.type"/>
                        <FXTableColumn realWidth="100" valueName="sizeControl" text="%base.length"/>
                        <FXTableColumn realWidth="70" valueName="digitsControl" text="%base.digits"/>
                        <FXTableColumn realWidth="60" valueName="primaryKeyControl" text="%base.key"/>
                        <FXTableColumn realWidth="80" valueName="nullableControl" text="%base.nullable"/>
                        <FXTableColumn realWidth="70" valueName="uniqueControl" text="%shell.h2.unique"/>
                        <FXTableColumn flexWidth="58% - 380" valueName="commentControl" text="%base.comment"/>
                    </columns>
                </DBStatusTableView>
                <fx:include fx:id="tableColumnExtra" source="shellH2TableColumnExtra.fxml"/>
            </FXVBox>
        </FixedTab>
        <FixedTab text="%base.indexes" fx:id="indexTab">
            <DBStatusTableView fixedCellSize="30" fx:id="indexTable" flexWidth="100%" flexHeight="100%">
                <columns>
                    <DBStatusColumn/>
                    <FXTableColumn flexWidth="25%" valueName="nameControl" text="%base.name"/>
                    <FXTableColumn flexWidth="40%" valueName="columnControl" text="%base.column"/>
                    <FXTableColumn realWidth="80" valueName="uniqueControl" text="%shell.h2.unique"/>
                    <FXTableColumn realWidth="120" valueName="typeControl" text="%base.indexType"/>
                </columns>
            </DBStatusTableView>
        </FixedTab>
        <FixedTab text="%base.foreignKeys" fx:id="foreignKeyTab">
            <DBStatusTableView fixedCellSize="30" fx:id="foreignKeyTable" flexWidth="100%" flexHeight="100%">
                <columns>
                    <DBStatusColumn/>
                    <FXTableColumn flexWidth="40% - 290" valueName="nameControl" text="%base.name"/>
                    <FXTableColumn flexWidth="20%" valueName="columnControl" text="%base.fields"/>
                    <FXTableColumn flexWidth="20%" valueName="referencedTableControl" text="%base.referencedTable"/>
                    <FXTableColumn flexWidth="20%" valueName="referencedColumnControl" text="%base.referencedFields"/>
                    <FXTableColumn realWidth="120" valueName="deletePolicyControl" text="%base.onDelete"/>
                    <FXTableColumn realWidth="120" valueName="updatePolicyControl" text="%base.onUpdate"/>
                </columns>
            </DBStatusTableView>
        </FixedTab>
        <FixedTab text="%base.triggers" fx:id="triggerTab">
            <DBStatusTableView fixedCellSize="30" fx:id="triggerTable" flexWidth="100%" flexHeight="100%">
                <columns>
                    <DBStatusColumn/>
                    <FXTableColumn flexWidth="45% - 290" valueName="nameControl" text="%base.name"/>
                    <FXTableColumn realWidth="250" valueName="policyControl" text="%base.policy"/>
                    <FXTableColumn flexWidth="55%" valueName="definitionControl" text="%base.definition"/>
                </columns>
            </DBStatusTableView>
        </FixedTab>
        <FixedTab text="%base.checks" fx:id="checkTab">
            <DBStatusTableView fixedCellSize="30" fx:id="checkTable" flexWidth="100%" flexHeight="100%">
                <columns>
                    <DBStatusColumn/>
                    <FXTableColumn flexWidth="30%" valueName="nameControl" text="%base.name"/>
                    <FXTableColumn flexWidth="70% - 40" valueName="clauseControl" text="%base.clause"/>
                </columns>
            </DBStatusTableView>
        </FixedTab>
        <FixedTab text="%shell.h2.tableConstraints" fx:id="constraintTab">
            <FXTextArea fx:id="constraints" flexWidth="100%" flexHeight="100%"/>
        </FixedTab>
        <FixedTab text="%base.comment">
            <FXTextArea fx:id="tableComment" tipText="%base.comment" maxLen="1024"
                        flexWidth="100%" flexHeight="100%"/>
        </FixedTab>
        <FixedTab text="%shell.h2.preview" fx:id="previewTab">
            <ShellDataEditor fx:id="preview" formatType="SQL" editable="false"
                             flexWidth="100%" flexHeight="100%"/>
        </FixedTab>
    </RichTabPane>
</FXVBox>
