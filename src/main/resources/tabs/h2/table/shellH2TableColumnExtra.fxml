<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyshell.fx.h2.H2ColumnKindComboBox?>
<?import cn.oyzh.easyshell.fx.h2.table.ShellH2DefaultValueTextFiled?>
<?import cn.oyzh.fx.gui.label.AccentLabel?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.button.FXCheckBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.tabs.h2.table.ShellH2TableColumnExtraController"
        realHeight="200">
    <FXHBox flexWidth="100%" realHeight="30" fx:id="columnKindBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%shell.h2.column.kind">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <H2ColumnKindComboBox fx:id="columnKind" realHeight="25" flexWidth="100% - 140">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </H2ColumnKindComboBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="autoIncrementBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%base.autoIncrement">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <FXCheckBox fx:id="autoIncrement" prefHeight="25" text="%base.autoIncrement">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </FXCheckBox>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="defaultValueBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%base.defaultValue">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <ShellH2DefaultValueTextFiled fx:id="defaultValue" realHeight="25" flexWidth="100% - 140"
                                          styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </ShellH2DefaultValueTextFiled>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="checkBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%base.check">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <ClearableTextField fx:id="check" realHeight="25" flexWidth="100% - 140" styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </ClearableTextField>
    </FXHBox>
    <FXHBox flexWidth="100%" realHeight="30" fx:id="generatedExpressionBox" managed="false" visible="false">
        <AccentLabel realHeight="25" realWidth="80" text="%shell.h2.expression">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </AccentLabel>
        <ClearableTextField fx:id="generatedExpression" realHeight="25" flexWidth="100% - 140"
                            styleClass="popover-item">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </ClearableTextField>
    </FXHBox>
</FXVBox>
