<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyshell.fx.ShellDataEditor?>
<?import cn.oyzh.easyshell.fx.sqlite.SQLiteResultTableView?>
<?import cn.oyzh.easyshell.query.sqlite.ShellSqliteQueryEditor?>
<?import cn.oyzh.fx.gui.svg.glyph.ExportSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.database.ExplainSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.PrettySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RunSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.pane.FXSplitPane?>
<?import cn.oyzh.fx.plus.controls.tab.FXTabPane?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.sqlite.query.ShellSqliteQueryMainTabController"
        fx:id="root" flexWidth="100%" flexHeight="100%">
    <FXHBox realHeight="30" flexWidth="100%">
        <SaveSVGGlyph onMousePrimaryClicked="#save">
            <HBox.margin><Insets left="10" top="10"/></HBox.margin>
        </SaveSVGGlyph>
        <PrettySVGGlyph onMousePrimaryClicked="#pretty">
            <HBox.margin><Insets left="5" top="10"/></HBox.margin>
        </PrettySVGGlyph>
        <RunSVGGlyph onMousePrimaryClicked="#run">
            <HBox.margin><Insets left="5" top="10"/></HBox.margin>
        </RunSVGGlyph>
        <ExplainSVGGlyph onMousePrimaryClicked="#explain">
            <HBox.margin><Insets left="5" top="10"/></HBox.margin>
        </ExplainSVGGlyph>
    </FXHBox>
    <FXSplitPane showDivider="false" orientation="VERTICAL" fx:id="splitPane"
                 flexWidth="100%" flexHeight="100% - 32" dividerPositions="1">
        <ShellSqliteQueryEditor fx:id="queryArea" flexWidth="100%" flexHeight="100%"
                                onKeyPressed="#queryKeyPressed"/>
        <FXTabPane fx:id="resultTabPane" flexWidth="100%" flexHeight="100%" visible="false" managed="false">
            <FixedTab text="%base.info" fx:id="infoTab">
                <ShellDataEditor fx:id="resultInfo" lineNumbersEnabled="false" formatType="SQL" editable="false"
                                 flexWidth="100%" flexHeight="100%"/>
            </FixedTab>
            <FixedTab text="%base.result" fx:id="resultTab">
                <FXVBox flexWidth="100%" flexHeight="100%">
                    <FXHBox realHeight="30" flexWidth="100%">
                        <ExportSVGGlyph tipText="%base.export" onMousePrimaryClicked="#exportResult">
                            <HBox.margin><Insets left="10" top="10"/></HBox.margin>
                        </ExportSVGGlyph>
                    </FXHBox>
                    <SQLiteResultTableView fixedCellSize="30" fx:id="resultTable" flexWidth="100%"
                                           flexHeight="100% - 30" tableMenuButtonVisible="true"/>
                </FXVBox>
            </FixedTab>
        </FXTabPane>
    </FXSplitPane>
</FXVBox>
