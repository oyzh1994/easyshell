<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyshell.fx.ShellDataEditor?>
<?import cn.oyzh.easyshell.query.sqlite.ShellSqliteQueryEditor?>
<?import cn.oyzh.fx.gui.svg.glyph.RefreshSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RunSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.tabs.RichTabPane?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.tabs.sqlite.view.ShellSqliteViewDesignTabController"
        flexWidth="100%" flexHeight="100%">
    <FXHBox realHeight="25" flexWidth="100%">
        <SaveSVGGlyph tipText="%shell.sqlite.save" onMousePrimaryClicked="#save">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </SaveSVGGlyph>
        <RefreshSVGGlyph fx:id="refresh" groupId="action3" tipText="%base.refresh"
                         onMousePrimaryClicked="#refresh" managedBindVisible="true" visible="false">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </RefreshSVGGlyph>
    </FXHBox>
    <RichTabPane fx:id="tabPane" flexWidth="100%" flexHeight="100% - 25">
        <FixedTab text="%base.definition" fx:id="definitionTab">
            <ShellSqliteQueryEditor fx:id="definition" flexWidth="100%" flexHeight="100%"/>
        </FixedTab>
        <FixedTab text="%shell.sqlite.preview" fx:id="previewTab">
            <ShellDataEditor fx:id="preview" formatType="SQL" editable="false"
                             flexWidth="100%" flexHeight="100%"/>
        </FixedTab>
    </RichTabPane>
</FXVBox>
