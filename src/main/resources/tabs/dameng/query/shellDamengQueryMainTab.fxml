<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.query.dameng.ShellDamengQueryEditor?>
<?import cn.oyzh.easyshell.tabs.dameng.query.ShellDamengQueryInfoTab?>
<?import cn.oyzh.fx.gui.svg.glyph.database.ExplainSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.PrettySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RunSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.pane.FXSplitPane?>
<?import cn.oyzh.fx.plus.controls.tab.FXTabPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="cn.oyzh.easyshell.tabs.dameng.query.ShellDamengQueryMainTabController" flexWidth="100%"
        flexHeight="100%"
        fx:id="root">
    <FXHBox realHeight="30" flexWidth="100%">
        <SaveSVGGlyph onMousePrimaryClicked="#save">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </SaveSVGGlyph>
        <PrettySVGGlyph onMousePrimaryClicked="#pretty">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </PrettySVGGlyph>
        <RunSVGGlyph onMousePrimaryClicked="#run">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </RunSVGGlyph>
        <ExplainSVGGlyph onMousePrimaryClicked="#explain">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </ExplainSVGGlyph>
    </FXHBox>
    <FXSplitPane showDivider="false" orientation="VERTICAL" fx:id="splitPane" flexWidth="100%" flexHeight="100% - 32"
                 dividerPositions="1">
        <ShellDamengQueryEditor fx:id="queryArea" flexWidth="100%" onKeyPressed="#queryKeyPressed"/>
        <FXTabPane fx:id="resultTabPane" flexWidth="100%" visible="false" managed="false">
            <ShellDamengQueryInfoTab fx:id="infoTab" text="%base.info">
            </ShellDamengQueryInfoTab>
        </FXTabPane>
    </FXSplitPane>
</FXVBox>
