<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyshell.fx.ShellDataEditor?>
<?import cn.oyzh.fx.gui.button.CloseButton?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.text.field.ReadOnlyTextField?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.FXHeaderBar?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import cn.oyzh.fx.plus.controls.tab.FXTabPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.dameng.sequence.ShellDamengSequenceInfoController" realWidth="750"
        realHeight="600">
    <FXHeaderBar/>
    <FXTabPane flexWidth="100%" flexHeight="100% - 90">
        <FixedTab text="%base.base">
            <FXVBox flexHeight="100%" flexWidth="100%">
                <InfoLabel text="%base.name">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField fx:id="name" realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.min">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField editable="false" fx:id="minVal" realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.max">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField editable="false" fx:id="maxVal" realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.current">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField editable="false" fx:id="currentVal" realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.incrementBy">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField editable="false" fx:id="incrementBy" realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.order">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField editable="false" fx:id="order" realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.cycle">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField editable="false" fx:id="cycle" realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
            </FXVBox>
        </FixedTab>
        <FixedTab text="%base.ddl">
            <FXVBox flexHeight="100%" flexWidth="100%">
                <ShellDataEditor lineNumbersEnabled="false" formatType="SQL" editable="false" fx:id="createDefinition"
                                 flexHeight="100% - 20"
                                 flexWidth="100% - 60">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </ShellDataEditor>
            </FXVBox>
        </FixedTab>
    </FXTabPane>
    <FXHBox flexWidth="100%">
        <CloseButton>
            <HBox.margin>
                <Insets left="30" top="15"/>
            </HBox.margin>
        </CloseButton>
    </FXHBox>
</FXVBox>
