<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.llm.LLMView?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.HistorySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.llm.MCPSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.llm.LLMSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.llm.ModelSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.llm.PromptSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.llm.SkillSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FXVBox fx:id="root" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.llm.ChatController"
        flexHeight="100%" visible="false" managed="false" managedBindVisible="true">
    <FXHBox realHeight="30" flexWidth="100%">
        <AddSVGGlyph tipText="%base.add" onMousePrimaryClicked="#newSession">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </AddSVGGlyph>
        <HistorySVGGlyph tipText="%base.history" onMousePrimaryClicked="#history">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </HistorySVGGlyph>
        <PromptSVGGlyph tipText="%shell.llm.prompts" onMousePrimaryClicked="#prompt">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </PromptSVGGlyph>
        <SkillSVGGlyph tipText="%shell.llm.skills" onMousePrimaryClicked="#skill">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </SkillSVGGlyph>
        <MCPSVGGlyph tipText="%shell.llm.mcp.servers" onMousePrimaryClicked="#mcp">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </MCPSVGGlyph>
        <ModelSVGGlyph tipText="%shell.llm.models" onMousePrimaryClicked="#model">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </ModelSVGGlyph>
        <LLMSVGGlyph tipText="%base.llm" onMousePrimaryClicked="#llm">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </LLMSVGGlyph>
    </FXHBox>
    <LLMView fx:id="view" flexHeight="100% - 30" flexWidth="100%"/>
</FXVBox>

