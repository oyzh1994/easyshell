<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.llm.LLMProviderActiveTableColumn?>
<?import cn.oyzh.easyshell.fx.llm.LLMProviderTableView?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.EditSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.FXHeaderBar?>
<?import cn.oyzh.fx.plus.controls.table.FXTableColumn?>
<?import javafx.geometry.Insets?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.llm.ShellLLMProviderListController"
        realWidth="900" realHeight="500">
    <FXHeaderBar/>
    <FXVBox flexWidth="100%" flexHeight="100% - 30">
        <FXHBox realHeight="30">
            <AddSVGGlyph onMousePrimaryClicked="#add">
                <FXHBox.margin>
                    <Insets left="30" top="7"/>
                </FXHBox.margin>
            </AddSVGGlyph>
            <EditSVGGlyph onMousePrimaryClicked="#update">
                <FXHBox.margin>
                    <Insets left="5" top="7"/>
                </FXHBox.margin>
            </EditSVGGlyph>
            <DeleteSVGGlyph onMousePrimaryClicked="#delete">
                <FXHBox.margin>
                    <Insets left="5" top="7"/>
                </FXHBox.margin>
            </DeleteSVGGlyph>
            <FXVBox.margin>
                <Insets top="10"/>
            </FXVBox.margin>
        </FXHBox>
        <LLMProviderTableView fx:id="providerTableView" flexWidth="100% - 50" flexHeight="100% - 60">
            <columns>
                <FXTableColumn prefWidth="170" valueName="name" text="%base.name"/>
                <FXTableColumn prefWidth="110" valueName="apiTypeName" text="%base.type"/>
                <FXTableColumn flexWidth="100% - 555" valueName="baseUrl" text="%base.url"/>
                <FXTableColumn prefWidth="160" valueName="modelsText" text="%base.model"/>
                <LLMProviderActiveTableColumn prefWidth="100" text="%base.status"/>
            </columns>
            <FXVBox.margin>
                <Insets left="30" top="7"/>
            </FXVBox.margin>
        </LLMProviderTableView>
    </FXVBox>
</FXVBox>
