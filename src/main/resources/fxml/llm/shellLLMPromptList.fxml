<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.llm.LLMPromptTableView?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.EditSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.FXHeaderBar?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.table.FXTableColumn?>
<?import javafx.geometry.Insets?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.llm.ShellLLMPromptListController"
        realWidth="900" realHeight="500">
    <FXHeaderBar/>
    <FXVBox flexWidth="100%" flexHeight="100% - 30">
        <FXHBox realHeight="30">
            <AddSVGGlyph onMousePrimaryClicked="#add">
                <FXHBox.margin>
                    <Insets left="30" top="7"/>
                </FXHBox.margin>
            </AddSVGGlyph>
            <EditSVGGlyph onMousePrimaryClicked="#update">
                <FXHBox.margin>
                    <Insets left="5" top="7"/>
                </FXHBox.margin>
            </EditSVGGlyph>
            <DeleteSVGGlyph onMousePrimaryClicked="#delete">
                <FXHBox.margin>
                    <Insets left="5" top="7"/>
                </FXHBox.margin>
            </DeleteSVGGlyph>
            <FXVBox.margin>
                <Insets top="10"/>
            </FXVBox.margin>
        </FXHBox>
        <LLMPromptTableView fx:id="promptTableView" flexWidth="100% - 50"
                            flexHeight="100% - 60">
            <columns>
                <FXTableColumn prefWidth="180" valueName="name" text="%base.name"/>
                <FXTableColumn flexWidth="100% - 230" valueName="contentPreview"
                               text="%shell.llm.prompt.content"/>
            </columns>
            <FXVBox.margin>
                <Insets left="30" top="7"/>
            </FXVBox.margin>
        </LLMPromptTableView>
    </FXVBox>
</FXVBox>
