<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.fx.editor.incubator.control.MarkdownEditor?>
<?import cn.oyzh.fx.gui.button.CancelButton?>
<?import cn.oyzh.fx.gui.button.SubmitButton?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.FXHeaderBar?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.llm.ShellLLMAddPromptController"
        realWidth="800" realHeight="680">
    <FXHeaderBar/>
    <InfoLabel text="%base.name">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <ClearableTextField fx:id="name" tipText="%shell.llm.prompt.nameTip"
                        require="true" realHeight="30" flexWidth="100% - 140"
                        maxLen="10">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </ClearableTextField>
    <InfoLabel text="%shell.llm.prompt.content">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <MarkdownEditor fx:id="content" flexWidth="100% - 140"
                    flexHeight="100% - 235" tipText="%shell.llm.prompt.contentTip">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </MarkdownEditor>
    <FXHBox>
        <SubmitButton onAction="#add">
            <HBox.margin>
                <Insets left="30" top="15"/>
            </HBox.margin>
        </SubmitButton>
        <CancelButton>
            <HBox.margin>
                <Insets left="15" top="15"/>
            </HBox.margin>
        </CancelButton>
    </FXHBox>
</FXVBox>
