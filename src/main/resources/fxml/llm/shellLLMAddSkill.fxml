<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.fx.gui.button.CancelButton?>
<?import cn.oyzh.fx.gui.button.SubmitButton?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.FXHeaderBar?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.button.FXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.llm.ShellLLMAddSkillController"
        realWidth="800" realHeight="270">
    <FXHeaderBar/>
    <InfoLabel text="%base.name">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <ClearableTextField fx:id="name" require="true" maxLen="64"
                        realHeight="30" flexWidth="100% - 140">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </ClearableTextField>
    <InfoLabel text="%shell.llm.skill.file">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXHBox>
        <ClearableTextField fx:id="sourcePath" editable="false"
                            flexWidth="100% - 360" realHeight="30">
            <HBox.margin>
                <Insets left="30" top="5"/>
            </HBox.margin>
        </ClearableTextField>
        <FXButton text="%shell.llm.skill.selectFile" onAction="#chooseFile">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </FXButton>
        <FXButton text="%shell.llm.skill.selectFolder" onAction="#chooseFolder">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </FXButton>
    </FXHBox>
    <FXHBox>
        <SubmitButton onAction="#add">
            <HBox.margin>
                <Insets left="30" top="15"/>
            </HBox.margin>
        </SubmitButton>
        <CancelButton>
            <HBox.margin>
                <Insets left="15" top="15"/>
            </HBox.margin>
        </CancelButton>
    </FXHBox>
</FXVBox>
