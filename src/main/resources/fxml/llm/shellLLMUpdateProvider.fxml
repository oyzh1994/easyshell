<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.llm.LLMApiTypeComboBox?>
<?import cn.oyzh.easyshell.fx.llm.LLMProviderTemplateTextField?>
<?import cn.oyzh.fx.gui.button.CancelButton?>
<?import cn.oyzh.fx.gui.button.SubmitButton?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.gui.text.field.PasswordTextField?>
<?import cn.oyzh.fx.gui.text.field.SelectTextFiled?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.button.FXButton?>
<?import cn.oyzh.fx.plus.controls.FXHeaderBar?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.llm.ShellLLMUpdateProviderController" realWidth="750"
        realHeight="600">
    <FXHeaderBar/>
    <InfoLabel text="%shell.llm.template">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <LLMProviderTemplateTextField fx:id="template" flexWidth="100% - 140" prefHeight="30"
                                  tipText="%shell.llm.templateTip">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </LLMProviderTemplateTextField>
    <InfoLabel text="%base.name">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <ClearableTextField fx:id="name" tipText="%base.nameTip" require="true" realHeight="30"
                        flexWidth="100% - 140" maxLen="1024">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </ClearableTextField>
    <InfoLabel text="%base.url">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <ClearableTextField fx:id="baseUrl" require="true" realHeight="30"
                        flexWidth="100% - 140" tipText="%base.hostTip">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </ClearableTextField>
    <InfoLabel text="SK">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <PasswordTextField fx:id="sk" require="true" realHeight="30"
                        flexWidth="100% - 140" tipText="%base.contentTip1">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </PasswordTextField>
    <InfoLabel text="%base.type">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <LLMApiTypeComboBox fx:id="apiType" flexWidth="100% - 140" prefHeight="30">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </LLMApiTypeComboBox>
    <InfoLabel text="%base.model">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <FXHBox>
        <SelectTextFiled fx:id="model" flexWidth="100% - 285" prefHeight="30">
            <HBox.margin>
                <Insets left="30" top="5"/>
            </HBox.margin>
        </SelectTextFiled>
        <FXButton fx:id="fetchModelButton" text="%base.fetch" onAction="#fetchModels">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </FXButton>
    </FXHBox>
    <FXHBox>
        <SubmitButton onAction="#update">
            <HBox.margin>
                <Insets left="30" top="20"/>
            </HBox.margin>
        </SubmitButton>
        <CancelButton>
            <HBox.margin>
                <Insets left="15" top="20"/>
            </HBox.margin>
        </CancelButton>
    </FXHBox>
</FXVBox>
