                     所有剩余空间由 vgrow=ALWAYS 统一分配，工具栏与底部栏保持固定高度 -->
                <FXScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="connect-guide-scroll"
                              minHeight="0" prefHeight="0" VBox.vgrow="ALWAYS">
                    <FXVBox fx:id="sectionBox" spacing="16" styleClass="connect-guide-sections">
