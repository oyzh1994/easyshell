            <FXVBox styleClass="connect-guide-sidebar" prefWidth="196" minWidth="196" spacing="6">
                <padding>
                    <Insets left="18" right="12" top="18" bottom="18"/>
                </padding>
                <FXLabel text="%base.type" styleClass="connect-guide-side-title"/>
                <FXVBox spacing="4" VBox.vgrow="ALWAYS">
                    <FXRadioButton styleClass="connect-guide-category" toggleGroup="$categoryGroup"
                                   text="%base.all" userData="ALL" selected="true" onAction="#renderTypes"/>
                    <FXRadioButton styleClass="connect-guide-category" toggleGroup="$categoryGroup"
                                   text="%base.terminal" userData="TERMINAL" onAction="#renderTypes"/>
                    <FXRadioButton styleClass="connect-guide-category" toggleGroup="$categoryGroup"
                                   text="%base.file" userData="FILE" onAction="#renderTypes"/>
                    <FXRadioButton styleClass="connect-guide-category" toggleGroup="$categoryGroup"
                                   text="S3" userData="S3" onAction="#renderTypes"/>
                    <FXRadioButton styleClass="connect-guide-category" toggleGroup="$categoryGroup"
                                   text="%base.remote" userData="REMOTE" onAction="#renderTypes"/>
                    <FXRadioButton styleClass="connect-guide-category" toggleGroup="$categoryGroup"
                                   text="%base.database" userData="DATABASE" onAction="#renderTypes"/>
                    <FXRadioButton styleClass="connect-guide-category" toggleGroup="$categoryGroup"
                                   text="%base.other" userData="OTHER" onAction="#renderTypes"/>
                </FXVBox>
            </FXVBox>
        </left>
