<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.connect.ShellAddConnectGuidController"
        styleClass="connect-guide-root"
        realWidth="960"
        realHeight="640">
    <fx:define>
        <FXToggleGroup fx:id="categoryGroup"/>
        <FXToggleGroup fx:id="cardGroup"/>
    </fx:define>

    <FXHeaderBar/>
    <FXHBox styleClass="connect-guide-header" alignment="CENTER_LEFT" spacing="14">
        <padding>
            <Insets left="26" right="26" top="18" bottom="18"/>
        </padding>
        <ConnectionSVGGlyph sizeStr="34,34"/>
        <FXVBox spacing="4">
            <FXLabel text="%base.addConnect" styleClass="connect-guide-title"/>
            <FXLabel fx:id="subtitleLabel" styleClass="connect-guide-subtitle"/>
        </FXVBox>
    </FXHBox>

