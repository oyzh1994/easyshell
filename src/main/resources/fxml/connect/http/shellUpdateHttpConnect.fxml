<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.proxy.ShellProxyAuthTypeComboBox?>
<?import cn.oyzh.easyshell.fx.proxy.ShellProxyProtocolComboBox?>
<?import cn.oyzh.fx.gui.button.CancelButton?>
<?import cn.oyzh.fx.gui.button.SubmitButton?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.gui.text.field.NumberTextField?>
<?import cn.oyzh.fx.gui.text.field.PasswordTextField?>
<?import cn.oyzh.fx.gui.text.field.PortTextField?>
<?import cn.oyzh.fx.gui.toggle.SwitchToggleSwitch?>
<?import cn.oyzh.fx.plus.controls.FXHeaderBar?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.label.FXLabel?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import cn.oyzh.fx.plus.controls.tab.FXTabPane?>
<?import cn.oyzh.fx.plus.controls.text.area.FXTextArea?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.connect.http.ShellUpdateHttpConnectController"
        realWidth="650" realHeight="520">
    <FXHeaderBar/>
    <FXTabPane fx:id="tabPane" flexWidth="100%" flexHeight="100% - 80">
        <FixedTab text="%base.base">
            <FXVBox flexWidth="100%" flexHeight="100%">
                <InfoLabel text="%base.name">
                    <VBox.margin>
                        <Insets left="30" top="15"/>
                    </VBox.margin>
                </InfoLabel>
                <ClearableTextField fx:id="name" promptText="%shell.http.workspace" require="true"
                                    realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ClearableTextField>
                <InfoLabel text="%shell.http.timeout">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <FXHBox>
                    <NumberTextField fx:id="connectTimeOut" min="1" max="600" value="30"
                                     realHeight="30" realWidth="130" require="true">
                        <HBox.margin>
                            <Insets left="30" top="5"/>
                        </HBox.margin>
                    </NumberTextField>
                    <FXLabel text="%base.seconds" realHeight="24">
                        <HBox.margin>
                            <Insets left="8" top="9"/>
                        </HBox.margin>
                    </FXLabel>
                </FXHBox>
                <InfoLabel text="%base.remark">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <FXTextArea fx:id="remark" realHeight="100" flexWidth="100% - 180" tipText="%base.remarkTip">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </FXTextArea>
            </FXVBox>
        </FixedTab>
        <FixedTab text="%base.proxy" fx:id="proxyTab">
            <FXVBox flexWidth="100%" flexHeight="100%">
                <InfoLabel text="%base.enableProxy">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <SwitchToggleSwitch fx:id="enableProxy">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </SwitchToggleSwitch>
                <InfoLabel text="%base.protocol">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ShellProxyProtocolComboBox initIndex="0" disable="true" fx:id="proxyProtocol"
                                            tipText="%base.hostTip" require="true" realHeight="30"
                                            flexWidth="100% - 180" groupId="proxy">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ShellProxyProtocolComboBox>
                <InfoLabel text="%base.host">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <FXHBox disable="true" groupId="proxy">
                    <ClearableTextField fx:id="proxyHost" tipText="%base.hostTip" require="true"
                                        realHeight="30" flexWidth="100% - 285" maxLen="1024">
                        <HBox.margin>
                            <Insets left="30" top="5"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <PortTextField realWidth="100" fx:id="proxyPort" require="true" realHeight="30" value="7890">
                        <HBox.margin>
                            <Insets left="5" top="5"/>
                        </HBox.margin>
                    </PortTextField>
                </FXHBox>
                <InfoLabel text="%base.authMethod">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ShellProxyAuthTypeComboBox initIndex="0" disable="true" groupId="proxy"
                                            fx:id="proxyAuthType" realHeight="30"
                                            flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ShellProxyAuthTypeComboBox>
                <InfoLabel text="%base.authInfo">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <FXHBox disable="true" fx:id="proxyAuthInfoBox" groupId="proxy">
                    <ClearableTextField fx:id="proxyUser" tipText="%base.userNameTip" require="true"
                                        realHeight="30" flexWidth="50% - 90">
                        <HBox.margin>
                            <Insets left="30" top="5"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <PasswordTextField fx:id="proxyPassword" tipText="%base.passwordTip" require="true"
                                       realHeight="30" flexWidth="50% - 95">
                        <HBox.margin>
                            <Insets left="5" top="5"/>
                        </HBox.margin>
                    </PasswordTextField>
                </FXHBox>
            </FXVBox>
        </FixedTab>
    </FXTabPane>
    <FXHBox flexWidth="100%" realHeight="55">
        <SubmitButton text="%base.submit" onAction="#update" realHeight="30">
            <HBox.margin>
                <Insets left="30" top="12"/>
            </HBox.margin>
        </SubmitButton>
        <CancelButton text="%base.cancel" realHeight="30">
            <HBox.margin>
                <Insets left="12" top="12"/>
            </HBox.margin>
        </CancelButton>
    </FXHBox>
</FXVBox>
