<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.fx.editor.incubator.Editor?>
<?import cn.oyzh.fx.gui.button.CancelButton?>
<?import cn.oyzh.fx.gui.button.SubmitButton?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.FXHeaderBar?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.gui.text.field.PasswordTextField?>
<?import cn.oyzh.fx.plus.controls.table.FXTableView?>
<?import cn.oyzh.fx.plus.controls.table.FXTableColumn?>
<FXVBox xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyshell.controller.mongo.user.ShellMongoUserCreateController" realWidth="1100"
        realHeight="650">
    <FXHeaderBar/>
    <FXVBox flexWidth="100%" flexHeight="100% - 30">
        <InfoLabel text="%base.userName">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <ClearableTextField require="true" fx:id="user" tipText="%base.userNameTip" realHeight="30" flexWidth="100% - 60">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </ClearableTextField>
        <InfoLabel text="%base.password">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <PasswordTextField require="true" fx:id="password" tipText="%base.passwordTip" realHeight="30" flexWidth="100% - 60">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </PasswordTextField>
        <InfoLabel text="%base.permissions">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <FXTableView fx:id="roleTableView" flexHeight="100% - 260" flexWidth="100% - 60">
            <columns>
                <FXTableColumn text="%base.database" flexWidth="12%" valueName="db"/>
                <FXTableColumn text="%base.permissions" flexWidth="88% - 12" valueName="rolesControl"/>
            </columns>
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </FXTableView>
        <FXHBox flexWidth="100%">
            <SubmitButton onAction="#create" text="%base.create">
                <HBox.margin>
                    <Insets left="30" top="15"/>
                </HBox.margin>
            </SubmitButton>
            <CancelButton>
                <HBox.margin>
                    <Insets left="15" top="15"/>
                </HBox.margin>
            </CancelButton>
        </FXHBox>
    </FXVBox>
</FXVBox>
