<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyshell.fx.dameng.table.DamengColumnListView?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import cn.oyzh.fx.gui.svg.glyph.SubmitSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.CancelSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.MoveUpSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.MoveDownSVGGlyph?>
<FXVBox  xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyshell.popups.dameng.DamengColumnFieldPopupController" realWidth="320"
          realHeight="200">
    <DamengColumnListView flexWidth="100%" flexHeight="100% - 25" fx:id="listView">
    </DamengColumnListView>
    <FXHBox flexWidth="100%" realHeight="25">
        <SubmitSVGGlyph onMousePrimaryClicked="#submit">
            <HBox.margin>
                <Insets left="10" top="5"/>
            </HBox.margin>
        </SubmitSVGGlyph>
        <CancelSVGGlyph onMousePrimaryClicked="#close">
            <HBox.margin>
                <Insets left="15" top="5"/>
            </HBox.margin>
        </CancelSVGGlyph>
        <MoveUpSVGGlyph onMousePrimaryClicked="#moveUpRow">
            <HBox.margin>
                <Insets left="15" top="3"/>
            </HBox.margin>
        </MoveUpSVGGlyph>
        <MoveDownSVGGlyph onMousePrimaryClicked="#moveDownRow">
            <HBox.margin>
                <Insets left="15" top="3"/>
            </HBox.margin>
        </MoveDownSVGGlyph>
    </FXHBox>
</FXVBox>
